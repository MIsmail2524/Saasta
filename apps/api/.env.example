# dev | test | prod
SAASTA_ENV=dev
SAASTA_PUBLIC_WEB_URL=http://localhost:3000
SAASTA_PUBLIC_API_URL=http://localhost:8000
SAASTA_CORS_ORIGINS=http://localhost:3000

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SAASTA_SECRET_KEY=
SAASTA_IP_HASH_SALT=

SAASTA_DATABASE_URL=sqlite+aiosqlite:///./data/saasta.db
# SAASTA_DATABASE_URL=postgresql+asyncpg://saasta:password@db:5432/saasta
# SAASTA_REDIS_URL=redis://redis:6379/0
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
SAASTA_TRUSTED_PROXY_HOPS=0

# Our own ML service (apps/ml). Leave empty to run with fingerprint matching only.
SAASTA_ML_URL=http://localhost:8100
SAASTA_ML_TOKEN=dev-ml-token

SAASTA_DEFAULT_COUNTRY=pk
SAASTA_DEFAULT_CURRENCY=PKR
# Optional FX override, units per 1 USD
# SAASTA_FX_JSON={"PKR": 281}
